# Backend server — copy to .env or .env.local for local development.
# NEVER commit real values. Set production secrets via your hosting provider's env config.

PORT=3000
# Public URL where this API is reachable (e.g. http://187.55.230.171:3000)
BACKEND_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
BETTER_AUTH_SECRET=
RESEND_API_KEY=

# Admin Dashboard (independent JWT auth — not Supabase mobile auth)
# Generate with: openssl rand -hex 48
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
# Optional comma-separated admin frontend origins (in addition to localhost/LAN/IP).
# Needed only when the browser calls the API on a different origin than the admin UI
# (same-origin Next.js proxy does not need this).
# Example for IP access without proxy: ADMIN_CORS_ORIGIN=http://187.55.230.171:3001
ADMIN_CORS_ORIGIN=http://localhost:3001
# Only used when seeding if admin user is missing — never commit real production passwords
# ADMIN_DEFAULT_PASSWORD=

# Optional — enables `bun run migrate:admin` against Postgres directly
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
