# Backend server — copy to .env or .env.local for local development.
# NEVER commit real values. Set production secrets via your hosting provider's env config.

PORT=3000
# Public URL where this API is reachable (HTTPS preferred in production)
# Production: https://api.pathplus.store
BACKEND_URL=https://api.pathplus.store
# Public marketing / app site used in auth emails (MUST NOT be localhost in production)
# Production: https://site.pathplus.store
PUBLIC_APP_URL=https://site.pathplus.store
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# Resend test sender (no domain verification required). For production use dev@pathplus.store after verifying pathplus.store.
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Admin Dashboard (independent JWT auth — not Supabase mobile auth)
# Generate with: openssl rand -hex 48
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
# Optional comma-separated admin frontend origins (in addition to localhost for local dev).
# Production dashboard: https://admin.pathplus.store
ADMIN_CORS_ORIGIN=https://admin.pathplus.store,http://admin.pathplus.store,http://localhost:3001,http://127.0.0.1:3001
# Only used when seeding if admin user is missing — never commit real production passwords
# ADMIN_DEFAULT_PASSWORD=

# Optional — AES-256-GCM master key for Admin-managed secrets (Resend key, etc.)
# Generate with: openssl rand -hex 32
# NEVER commit the real value. Required before storing secrets via Admin Dashboard.
# CONFIG_ENCRYPTION_KEY=

# Optional — enables `bun run migrate:admin` against Postgres directly
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
