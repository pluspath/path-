{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "studio": "cloud-studio --port 3001 --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "seed:admin": "bun run scripts/seed-admin.ts",
    "seed:legal": "bun run scripts/seed-legal-content.ts",
    "migrate:admin": "bun run scripts/apply-admin-migration.ts",
    "diagnose:auth": "bun run scripts/diagnose-auth-config.ts",
    "admin:install": "bun install --cwd admin",
    "admin:dev": "cd admin && bun run dev",
    "admin:build": "bun install --cwd admin && cd admin && bun run build",
    "admin:start": "cd admin && bun run start",
    "pm2:setup": "bash deploy/pm2-setup.sh",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env && pm2 save",
    "nginx:setup": "bash deploy/nginx-setup.sh"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "prisma": "6",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.6",
    "@hono/node-server": "1.12.0",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/client": "6",
    "@supabase/supabase-js": "^2.101.1",
    "@vibecodeapp/backend-sdk": "^1.0.1",
    "@vibecodeapp/cloud-studio": "^0.2.4",
    "@vibecodeapp/proxy": "^2.0.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.6",
    "hono": "4.6.0",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.4",
    "postgres": "^3.4.9",
    "resend": "^6.12.4",
    "zod": "4.1.11"
  }
}
